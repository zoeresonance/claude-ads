GOOGLE_AI_API_KEY=your_key_here
META_SYSTEM_TOKEN=your_system_user_token

# Fine-grained GitHub PAT scoped to this repo with "Contents: Read and write" permission.
# Required in deployed environments (e.g. Vercel) so "+ Add new client" can commit the new
# client's files to the repo — the deployed filesystem is read-only. Not required for local
# dev; without it, new clients are written straight to website/clients/ on disk instead.
GITHUB_CLIENTS_TOKEN=
